<script src="/images/js/js.cookie.js"></script>
 <script language="javascript" type="text/javascript">
        $(document).ready(function() {
            var
                timeout = 0,
                animate = 0,
                cookie_cookies_banner = parseInt(Cookies.get('cookies_banner'), 10),
                flag;

            if (!cookie_cookies_banner) {
                flag = "1";
            } else if (1 == cookie_cookies_banner) {
                flag = "";
            } else {
                return false;
            }

            if (flag) {
                timeout = 10000;
                animate = 3000;
            }

            var show = function (animate) {
                $('.cookies').show().animate( { 'bottom': "+=148px" } , animate);
            } ;

            var hide = function () {
                $('.cookies').hide();
            } ;

            setTimeout(function() {
                Cookies.set('cookies_banner', 1, { path: '/' } );
                show(animate);
            } , timeout);

            $('#cookies-close').click(function() {
                Cookies.set('cookies_banner', 365, { path: '/', expires: 365 } );
                hide();

                return false;
            } );
        } );
    </script>

    <div class="cookies" style="display: none">
