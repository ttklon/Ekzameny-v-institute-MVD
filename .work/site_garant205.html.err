    <script language="javascript" type="text/javascript">
        $(document).ready(function () {
            var
                timeout = 0,
                animate = 0,
                flag = "1",
                code = "social_banner",
                days = "7";

            if (flag) {
                timeout = 10000;
                animate = 3000;
            }
            ;

            var show = function (animate) {
                $('.popup-social').removeClass('hide').animate({'bottom': "+=130px"}, animate);
                $('.popup-social-mobile').removeClass('hide').animate({'bottom': "+=170px"}, animate);
                document.cookie = code + "=1; path=/;";
            };

            var hide = function () {
                $('.popup-social, .popup-social-mobile').stop().addClass('hide');
                var date = new Date;
                date.setDate(date.getDate() + parseInt(days));
                document.cookie = code + "=" + days + "; path=/; expires=" + date.toUTCString();
            };

            setTimeout(function () {
                show(animate);
            }, timeout);

            $('#close-banner, .popup-social-mobile .close').click(function () {
                hide();
            });

            $('#button-banner, .popup-social-mobile .btn-success').click(function () {
                hide();
            });

            function getCookie(name) {
                var matches = document.cookie.match(new RegExp(
                    "(?:^|; )" + name.replace(/([\.$?*|{}\(\)\[\]\\\/\+^])/g, '\\$1') + "=([^;]*)"
                ));

                return matches ? decodeURIComponent(matches[1]) : undefined;
            }
        });
    </script>

