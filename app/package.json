{
  "name": "cloud-exam-planner",
  "productName": "Облачный планировщик экзаменов",
  "version": "1.0.0",
  "description": "Красивый планировщик подготовки к экзаменам: импорт файлов вопрос-ответ, расчёт времени чтения, распределение нагрузки по дням, отслеживание прогресса.",
  "main": "main.js",
  "author": "Arena",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "test": "node test/core.test.js && node test/docx.test.js && node test/dom.test.js && node test/real-formats.test.js"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "jsdom": "^24.1.3"
  },
  "dependencies": {
    "iconv-lite": "^0.6.3",
    "jszip": "^3.10.1"
  },
  "build": {
    "appId": "ru.arena.cloudexamplanner",
    "productName": "Облачный планировщик экзаменов",
    "copyright": "Copyright © 2026",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*"
    ],
    "win": {
      "artifactName": "ExamPlanner-Setup.${ext}",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "language": "1049"
    }
  }
}
